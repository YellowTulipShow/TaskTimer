{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/YTS.TaskTimer/YTS.TaskTimer.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": {
                "owner": "my-custom-build",
                "source": "dotnet",
                "fileLocation": ["autoDetect", "${workspaceFolder}/src/YTS.TaskTimer"],
                "pattern": "$msCompile"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
